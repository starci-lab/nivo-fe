{
  "name": "nivo-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "starci": {
    "deliveryAssurance": {
      "required": true,
      "unitCoverage": {
        "statements": 80,
        "lines": 80,
        "functions": 80,
        "branches": 75,
        "patch": 90
      }
    },
    "codePatterns": {
      "next": {
        "schema": "starci/next-code-pattern-contract@1",
        "projects": [
          "apps/app/tsconfig.json",
          "apps/expert/tsconfig.json",
          "apps/landing/tsconfig.json",
          "packages/nivo-ui/tsconfig.json"
        ],
        "owners": [
          {
            "root": "apps/app/src/app/[locale]/(console)/agentos/workspaces/[workspaceId]",
            "name": "AgentOSWorkspace"
          },
          {
            "root": "apps/app/src/app/[locale]/(console)/agentos/workspaces/[workspaceId]/modules/[installationId]",
            "name": "AgentOS"
          },
          {
            "root": "apps/app/src/app/[locale]/(console)/apps/[siteId]",
            "name": "AcademyControlCenter"
          },
          {
            "root": "apps/app/src/app/[locale]/launch/agentos/[workspaceId]/openclaw",
            "name": "AgentOSOpenClawLaunch"
          },
          {
            "root": "apps/app/src/hooks/collab-live",
            "name": "CollabLive"
          },
          {
            "root": "apps/app/src/modules/academy",
            "name": "Academy"
          },
          {
            "root": "apps/app/src/modules/collab",
            "name": "Collab"
          },
          {
            "root": "apps/app/src/modules/realtime",
            "name": "ProvisioningRealtime"
          }
        ],
        "closedVocabularies": [
          {
            "path": "packages/nivo-ui/src/composites/LifecycleStep/index.tsx",
            "type": "LifecycleStepState",
            "inventory": "LIFECYCLE_STEP_STATES",
            "role": "state"
          }
        ],
        "grammarGuards": {
          "schema": "starci/grammar-guard-contract@1",
          "package": "@starci/grammar",
          "entry": "./common",
          "source": {
            "kind": "installed"
          },
          "vectorProfile": "starci/grammar-guards-v1"
        },
        "errorState": {
          "schema": "starci/next-error-state@1",
          "sourceRoots": [
            "apps/app/src",
            "apps/expert/src",
            "apps/landing/src"
          ],
          "transports": [],
          "worldMappings": [],
          "envelopes": [],
          "writes": [],
          "boundaries": [
            {
              "role": "global",
              "routeRoot": "apps/app/src/app",
              "path": "apps/app/src/app/global-error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/app/src/app/[locale]",
              "path": "apps/app/src/app/[locale]/error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/app/src/app/[locale]/(console)",
              "path": "apps/app/src/app/[locale]/(console)/error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "global",
              "routeRoot": "apps/expert/src/app",
              "path": "apps/expert/src/app/global-error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/expert/src/app/[locale]",
              "path": "apps/expert/src/app/[locale]/error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "global",
              "routeRoot": "apps/landing/src/app",
              "path": "apps/landing/src/app/global-error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/landing/src/app/[locale]",
              "path": "apps/landing/src/app/[locale]/error.tsx",
              "recoveryProp": "reset"
            }
          ],
          "requiredValues": []
        },
        "dataLifecycle": {
          "schema": "starci/next-data-lifecycle@1",
          "swr": {
            "package": "swr",
            "major": 2
          },
          "hooks": [
            {
              "id": "nivo-query",
              "path": "apps/app/src/hooks/swr/useNivoQuery.ts",
              "export": "useNivoQuery",
              "kind": "query",
              "identities": [
                {
                  "id": "key",
                  "binding": "key",
                  "gatesRequest": false,
                  "resource": true
                }
              ]
            },
            {
              "id": "nivo-mutation",
              "path": "apps/app/src/hooks/swr/useNivoMutation.ts",
              "export": "useNivoMutation",
              "kind": "mutation",
              "identities": [
                {
                  "id": "key",
                  "binding": "key",
                  "gatesRequest": false,
                  "resource": true
                }
              ]
            }
          ]
        }
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "academy:inject": "node scripts/inject-academy-template.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:app": "npm run dev -w @nivo/app",
    "dev:expert": "npm run dev -w @nivo/expert",
    "dev:landing": "npm run dev -w @nivo/landing",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:check": "npm run contract:check && turbo run lint -- --max-warnings=0 && npm run lint:architecture && npm run lint:i18n",
    "lint:architecture": "node scripts/check-fe-architecture.mjs && node scripts/check-dependency-alignment.mjs",
    "lint:i18n": "node scripts/check-i18n-catalog.mjs",
    "preinstall": "node scripts/check-dependency-alignment.mjs",
    "prepare": "husky",
    "sonar:check": "sonar-scanner-npm -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=600",
    "sync:ports": "node scripts/sync-ports.mjs",
    "test": "vitest run --passWithNoTests && node --test scripts/*.spec.mjs",
    "test:unit": "npm test",
    "test:ci": "vitest run --passWithNoTests --coverage && node --test scripts/*.spec.mjs && node scripts/write-patch-coverage.mjs",
    "coverage:patch": "node scripts/write-patch-coverage.mjs",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "codegen": "npm run codegen --workspace @nivo/app --workspace @nivo/expert --",
    "contract:check": "node scripts/contract-check.mjs",
    "pretest": "npm run codegen --silent",
    "pretest:ci": "npm run codegen --silent"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typed-document-node": "^5.1.2",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@playwright/test": "1.51.1",
    "@sonar/scan": "^5.0.0",
    "@starci/eslint-canon-fe": "6.0.2",
    "@starci/grammar": "0.7.2",
    "@starci/stylelint-canon": "2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "jest-axe": "11.0.0",
    "jsdom": "^29.1.1",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "swr": "^2.3.8",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@starci/grammar": "0.7.2",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@starci/eslint-canon-fe": "6.0.2",
    "react-aria": "3.52.1"
  }
}
