{
  "name": "nivo-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "starci": {
    "deliveryAssurance": {
      "required": true,
      "unitCoverage": {
        "statements": 80,
        "lines": 80,
        "functions": 80,
        "branches": 75,
        "patch": 90
      }
    },
    "codePatterns": {
      "next": {
        "schema": "starci/next-code-pattern-contract@1",
        "projects": [
          "apps/app/tsconfig.json",
          "apps/expert/tsconfig.json",
          "apps/landing/tsconfig.json",
          "packages/nivo-ui/tsconfig.json"
        ],
        "owners": [
          {
            "root": "apps/app/src/app/[locale]/(console)/agentos/workspaces/[workspaceId]",
            "name": "AgentOSWorkspace"
          },
          {
            "root": "apps/app/src/app/[locale]/(console)/agentos/workspaces/[workspaceId]/modules/[installationId]",
            "name": "AgentOS"
          },
          {
            "root": "apps/app/src/app/[locale]/(console)/apps/[siteId]",
            "name": "AcademyControlCenter"
          },
          {
            "root": "apps/app/src/app/[locale]/launch/agentos/[workspaceId]/openclaw",
            "name": "AgentOSOpenClawLaunch"
          },
          {
            "root": "apps/app/src/hooks/collab-live",
            "name": "CollabLive"
          },
          {
            "root": "apps/app/src/modules/academy",
            "name": "Academy"
          },
          {
            "root": "apps/app/src/modules/collab",
            "name": "Collab"
          },
          {
            "root": "apps/app/src/modules/realtime",
            "name": "ProvisioningRealtime"
          }
        ],
        "closedVocabularies": [
          {
            "path": "packages/nivo-ui/src/composites/LifecycleStep/index.tsx",
            "type": "LifecycleStepState",
            "inventory": "LIFECYCLE_STEP_STATES",
            "role": "state"
          }
        ],
        "grammarGuards": {
          "schema": "starci/grammar-guard-contract@1",
          "package": "@starci/grammar",
          "entry": "./common",
          "source": {
            "kind": "installed"
          },
          "vectorProfile": "starci/grammar-guards-v1"
        },
        "errorState": {
          "schema": "starci/next-error-state@1",
          "sourceRoots": [
            "apps/app/src",
            "apps/expert/src",
            "apps/landing/src"
          ],
          "transports": [],
          "worldMappings": [],
          "envelopes": [],
          "writes": [],
          "boundaries": [
            {
              "role": "global",
              "routeRoot": "apps/app/src/app",
              "path": "apps/app/src/app/global-error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/app/src/app/[locale]",
              "path": "apps/app/src/app/[locale]/error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/app/src/app/[locale]/(console)",
              "path": "apps/app/src/app/[locale]/(console)/error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "global",
              "routeRoot": "apps/expert/src/app",
              "path": "apps/expert/src/app/global-error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/expert/src/app/[locale]",
              "path": "apps/expert/src/app/[locale]/error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "global",
              "routeRoot": "apps/landing/src/app",
              "path": "apps/landing/src/app/global-error.tsx",
              "recoveryProp": "reset"
            },
            {
              "role": "segment",
              "routeRoot": "apps/landing/src/app/[locale]",
              "path": "apps/landing/src/app/[locale]/error.tsx",
              "recoveryProp": "reset"
            }
          ],
          "requiredValues": []
        },
        "dataLifecycle": {
          "schema": "starci/next-data-lifecycle@1",
          "swr": {
            "package": "swr",
            "major": 2
          },
          "hooks": [
            {
              "id": "nivo-query",
              "path": "apps/app/src/hooks/swr/useNivoQuery.ts",
              "export": "useNivoQuery",
              "kind": "query",
              "identities": [
                {
                  "id": "key",
                  "binding": "key",
                  "gatesRequest": false,
                  "resource": true
                }
              ]
            },
            {
              "id": "nivo-mutation",
              "path": "apps/app/src/hooks/swr/useNivoMutation.ts",
              "export": "useNivoMutation",
              "kind": "mutation",
              "identities": [
                {
                  "id": "key",
                  "binding": "key",
                  "gatesRequest": false,
                  "resource": true
                }
              ]
            }
          ]
        }
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:app": "npm run dev --workspace apps/app",
    "start:app": "npm run start --workspace apps/app",
    "dev:expert": "npm run dev --workspace apps/expert",
    "start:expert": "npm run start --workspace apps/expert",
    "dev:landing": "npm run dev --workspace apps/landing",
    "start:landing": "npm run start --workspace apps/landing",
    "codegen": "npm run codegen --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run codegen --silent && eslint . --fix --max-warnings=0 && stylelint \"{apps,packages}/*/src/**/*.css\" --fix",
    "lint:check": "npm run codegen --silent && eslint . --max-warnings=0 && stylelint \"{apps,packages}/*/src/**/*.css\"",
    "lint:report": "eslint . --format json --output-file reports/eslint.json",
    "lint:report:css": "stylelint \"{apps,packages}/*/src/**/*.css\" --formatter json --output-file reports/stylelint.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hfs:check": "hfs check",
    "hfs:report": "hfs check --sonar reports/hfs.sonar.json"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typed-document-node": "^5.1.2",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@sonar/scan": "^5.0.0",
    "@starci/eslint-canon-fe": "7.0.0",
    "@starci/grammar": "0.7.2",
    "@starci/hfs": "2.0.1",
    "@starci/prettier-config": "1.0.0",
    "@starci/stylelint-canon": "2.0.0",
    "@starci/tsconfig": "2.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "swr": "^2.3.8",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@starci/grammar": "0.7.2",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@starci/eslint-canon-fe": "7.0.0",
    "react-aria": "3.52.1"
  }
}
