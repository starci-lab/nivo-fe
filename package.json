{
  "name": "nivo-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "academy:inject": "node scripts/inject-academy-template.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:app": "npm run dev -w @nivo/app",
    "dev:expert": "npm run dev -w @nivo/expert",
    "dev:landing": "npm run dev -w @nivo/landing",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint",
    "prepare": "husky",
    "sonar:check": "sonar-scanner-npm -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=600",
    "sync:ports": "node scripts/sync-ports.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@sonar/scan": "^5.0.0",
    "@starci/eslint-canon-fe": "^1.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
