{
  "name": "nivo-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "starci": {
    "deliveryAssurance": {
      "required": true,
      "unitCoverage": {
        "statements": 80,
        "lines": 80,
        "functions": 80,
        "branches": 75,
        "patch": 90
      }
    },
    "codePatterns": {
      "next": {
        "schema": "starci/next-code-pattern-contract@1",
        "projects": [
          "apps/app/tsconfig.json",
          "apps/expert/tsconfig.json",
          "apps/landing/tsconfig.json",
          "packages/ui/tsconfig.json"
        ],
        "owners": [
          {
            "root": "apps/app/src/app/[locale]/(console)/agentos/workspaces/[workspaceId]",
            "name": "AgentOSWorkspace"
          },
          {
            "root": "apps/app/src/app/[locale]/(console)/agentos/workspaces/[workspaceId]/modules/[installationId]",
            "name": "AgentOS"
          },
          {
            "root": "apps/app/src/app/[locale]/(console)/apps/[siteId]",
            "name": "AcademyControlCenter"
          },
          {
            "root": "apps/app/src/app/[locale]/launch/agentos/[workspaceId]/openclaw",
            "name": "AgentOSOpenClawLaunch"
          },
          {
            "root": "apps/app/src/hooks/collab-live",
            "name": "CollabLive"
          },
          {
            "root": "apps/app/src/modules/academy",
            "name": "Academy"
          },
          {
            "root": "apps/app/src/modules/collab",
            "name": "Collab"
          },
          {
            "root": "apps/app/src/modules/realtime",
            "name": "ProvisioningRealtime"
          }
        ],
        "closedVocabularies": [
          {
            "path": "packages/ui/src/composites/LifecycleStep/index.tsx",
            "type": "LifecycleStepState",
            "inventory": "LIFECYCLE_STEP_STATES",
            "role": "state"
          }
        ],
        "grammarGuards": {
          "schema": "starci/grammar-guard-contract@1",
          "package": "@starci/grammar",
          "entry": "./common",
          "source": {
            "kind": "installed"
          },
          "vectorProfile": "starci/grammar-guards-v1"
        },
        "errorState": {
          "schema": "starci/next-error-state@1",
          "sourceRoots": [
            "apps/app/src",
            "apps/expert/src",
            "apps/landing/src",
            "packages/ui/src"
          ],
          "transports": [],
          "worldMappings": [],
          "envelopes": [],
          "writes": [],
          "boundaries": [],
          "requiredValues": []
        },
        "dataLifecycle": {
          "schema": "starci/next-data-lifecycle@1",
          "swr": {
            "package": "swr",
            "major": 2
          },
          "hooks": [
            {
              "id": "nivo-query",
              "path": "apps/app/src/hooks/swr/useNivoQuery.ts",
              "export": "useNivoQuery",
              "kind": "query",
              "identities": [
                {
                  "id": "key",
                  "binding": "key",
                  "gatesRequest": false,
                  "resource": true
                }
              ]
            },
            {
              "id": "nivo-mutation",
              "path": "apps/app/src/hooks/swr/useNivoMutation.ts",
              "export": "useNivoMutation",
              "kind": "mutation",
              "identities": [
                {
                  "id": "key",
                  "binding": "key",
                  "gatesRequest": false,
                  "resource": true
                }
              ]
            }
          ]
        }
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "academy:inject": "node scripts/inject-academy-template.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:app": "npm run dev -w @nivo/app",
    "dev:expert": "npm run dev -w @nivo/expert",
    "dev:landing": "npm run dev -w @nivo/landing",
    "format:check": "turbo run lint -- --max-warnings=0",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint -- --max-warnings=0 && npm run lint:architecture && npm run lint:i18n",
    "lint:architecture": "node scripts/check-fe-architecture.mjs",
    "lint:i18n": "node scripts/check-i18n-catalog.mjs",
    "prepare": "husky",
    "sonar:check": "sonar-scanner-npm -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=600",
    "sync:ports": "node scripts/sync-ports.mjs",
    "test": "vitest run && node --test scripts/*.spec.mjs",
    "test:unit": "npm test",
    "test:ci": "vitest run --coverage && node --test scripts/*.spec.mjs && node scripts/write-patch-coverage.mjs",
    "coverage:patch": "node scripts/write-patch-coverage.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --pretty false",
    "lint:e2e": "eslint e2e playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@sonar/scan": "^5.0.0",
    "@starci/eslint-canon-fe": "3.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
