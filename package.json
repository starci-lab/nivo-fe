{
  "name": "nivo-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "starci": {
    "deliveryAssurance": {
      "required": true,
      "unitCoverage": {
        "statements": 80,
        "lines": 80,
        "functions": 80,
        "branches": 75,
        "patch": 90
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "academy:inject": "node scripts/inject-academy-template.mjs",
    "starci:grammar:build": "npm --prefix ../starci-academy-fe/packages/grammar run build",
    "predev": "npm run starci:grammar:build",
    "predev:app": "npm run starci:grammar:build",
    "predev:expert": "npm run starci:grammar:build",
    "predev:landing": "npm run starci:grammar:build",
    "prebuild": "npm run starci:grammar:build",
    "pretest": "npm run starci:grammar:build",
    "pretest:ci": "npm run starci:grammar:build",
    "pretest:watch": "npm run starci:grammar:build",
    "pretypecheck": "npm run starci:grammar:build",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:app": "npm run dev -w @nivo/app",
    "dev:expert": "npm run dev -w @nivo/expert",
    "dev:landing": "npm run dev -w @nivo/landing",
    "format:check": "turbo run lint -- --max-warnings=0",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint -- --max-warnings=0 && npm run lint:architecture",
    "lint:architecture": "node scripts/check-fe-architecture.mjs",
    "prepare": "npm run starci:grammar:build && husky",
    "sonar:check": "sonar-scanner-npm -Dsonar.qualitygate.wait=true -Dsonar.qualitygate.timeout=600",
    "sync:ports": "node scripts/sync-ports.mjs",
    "test": "vitest run && node --test scripts/*.spec.mjs",
    "test:unit": "npm test",
    "test:ci": "vitest run --coverage && node --test scripts/*.spec.mjs && node scripts/write-patch-coverage.mjs",
    "coverage:patch": "node scripts/write-patch-coverage.mjs",
    "test:e2e": "npm run build && node --test e2e/*.spec.mjs",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@sonar/scan": "^5.0.0",
    "@starci/eslint-canon-fe": "3.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
